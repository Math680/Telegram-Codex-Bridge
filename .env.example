# Telegram bot
TELEGRAM_BOT_TOKEN=REPLACE_ME
# Single user
TELEGRAM_USER_ID=123456789
# Or multiple users (comma-separated)
# TELEGRAM_ALLOWED_USERS=123456789,987654321

# Codex CLI
CODEX_BIN=/usr/bin/codex
CODEX_TIMEOUT=120
CODEX_SANDBOX=workspace-write  # read-only | workspace-write | danger-full-access
CODEX_BYPASS_APPROVALS=0       # 1 to bypass approvals + sandbox
CODEX_SKIP_GIT_CHECK=1
DEFAULT_CODEX_MODEL=gpt-5.2-codex
DEFAULT_CODEX_REASONING=medium

# Workspace allowlist (aliases only)
ALLOWED_DIRS_JSON={"app":"/home/youruser/projects/my-app","docs":"/home/youruser/projects/docs"}
DEFAULT_DIR_ALIAS=app

# Behavior
ASK_ON_TEXT=0
ASK_ACK_MESSAGE=
SYSTEM_PROMPT=
SYSTEM_PROMPT_ENABLED=0
